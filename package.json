{
  "name": "pintapinta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.16.0 <23 || >=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:automation": "node --test automation/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run test && npm run test:automation && npm run build"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
